[Unit]
Description=Проверять новые коммиты arisheniaa каждые 5 минут

[Timer]
# Пауза после загрузки: дать докеру подняться, иначе первый запуск после
# перезагрузки сервера упадёт на недоступном демоне.
OnBootSec=3min
OnUnitActiveSec=5min
# Разрешаем systemd сдвигать срабатывание в пределах полуминуты, чтобы
# проверки не собирались в один момент с другими таймерами хоста.
AccuracySec=30s
# Если сервер был выключен и срабатывание пропущено — выполнить сразу
# после включения, а не ждать следующего окна.
Persistent=true
Unit=arisheniaa-autodeploy.service

[Install]
WantedBy=timers.target
